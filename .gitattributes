# Normalize all text files to LF in the repository and on checkout, so the embedded
# test-data vectors and scripts are byte-identical across Windows, Linux and macOS CI.
* text=auto eol=lf

# Explicitly text
*.cs      text eol=lf
*.csproj  text eol=lf
*.props   text eol=lf
*.targets text eol=lf
*.json    text eol=lf
*.tsv     text eol=lf
*.md      text eol=lf
*.ps1     text eol=lf
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.xml     text eol=lf
*.slnx    text eol=lf
*.patch   text eol=lf
*.editorconfig text eol=lf

# Binary assets (if any are added later)
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.gz  binary
