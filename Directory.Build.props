<Project>

  <!-- Shared metadata and build settings for all projects in the repository. -->
  <PropertyGroup>
    <Product>SqliteFtsSnowball</Product>
    <Authors>cloudcoderrr</Authors>
    <Company>cloudcoderrr</Company>
    <Copyright>Copyright (c) cloudcoderrr. Snowball stemmers (c) the Snowball project (BSD-3-Clause).</Copyright>
    <RepositoryUrl>https://github.com/cloudcoderrr/SqliteFtsSnowball</RepositoryUrl>
    <PackageProjectUrl>https://github.com/cloudcoderrr/SqliteFtsSnowball</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <!-- Version. CI overrides with -p:Version=<tag> on release. -->
    <VersionPrefix>0.1.0</VersionPrefix>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- The Snowball/libstemmer version vendored by scripts/fetch-snowball.ps1 -->
    <SnowballVersion>3.2.0</SnowballVersion>
  </PropertyGroup>

</Project>
