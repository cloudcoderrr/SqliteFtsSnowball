<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SnowballTests.Mobile.Maui.MainPage"
             Title="SqliteFtsSnowball">
    <Grid Padding="12" RowSpacing="8" RowDefinitions="Auto,Auto,Auto,*">
        <Label Grid.Row="0" Text="SqliteFtsSnowball — Mobile tests" FontSize="20" FontAttributes="Bold" />
        <Label Grid.Row="1" x:Name="SummaryLabel" Text="Starting…" FontSize="14" />
        <HorizontalStackLayout Grid.Row="2" Spacing="10">
            <Button x:Name="RunButton" Text="Run tests" Clicked="OnRunClicked" />
            <ActivityIndicator x:Name="Spinner" IsRunning="False" VerticalOptions="Center" />
        </HorizontalStackLayout>
        <CollectionView Grid.Row="3" x:Name="LogView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding .}" FontSize="11" FontFamily="monospace" Padding="2,0" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>


