<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SnowballTests.Desktop.Avalonia.MainWindow"
        Width="960" Height="680"
        Title="SqliteFtsSnowball — Desktop tests">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <TextBlock Text="SqliteFtsSnowball — Desktop test runner" FontSize="22" FontWeight="Bold" />
      <TextBlock x:Name="SummaryText" Text="Ready." FontSize="14" />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Name="RunButton" Content="Run tests" Click="OnRunClick" />
        <ProgressBar x:Name="Progress" Width="240" Height="18" Minimum="0" Maximum="100" />
        <TextBlock x:Name="LogPathText" VerticalAlignment="Center" Opacity="0.7" FontSize="11" />
      </StackPanel>
    </StackPanel>

    <Border Margin="0,10,0,0" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="6">
      <ListBox x:Name="LogList"
               FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
               FontSize="12"
               Background="Transparent" />
    </Border>
  </DockPanel>
</Window>
